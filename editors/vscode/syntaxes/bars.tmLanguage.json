{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Bars",
  "scopeName": "source.bars",
  "patterns": [
    { "include": "#comment" },
    { "include": "#string" },
    { "include": "#keyword" },
    { "include": "#macro" },
    { "include": "#special" },
    { "include": "#number" },
    { "include": "#bool-nil" },
    { "include": "#keyword-lit" },
    { "include": "#symbol" }
  ],
  "repository": {
    "comment": {
      "name": "comment.line.double-semicolon.bars",
      "match": ";;.*$"
    },
    "string": {
      "name": "string.quoted.double.bars",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.bars",
          "match": "\\\\."
        }
      ]
    },
    "keyword": {
      "name": "keyword.control.bars",
      "match": "(?x)\\b(\n        defn|defmacro|def|defconst|defstruct|deftype|deftrait|impl|\n        let|if|if-let|if-not|do|loop|recur|fn|match|\n        when|when-let|when-not|unless|cond|case|\n        require|extern|load|\n        doseq|for|dotimes|while|\n        and|or|not\n      )\\b"
    },
    "macro": {
      "name": "support.function.macro.bars",
      "match": "\\b(partial|complement|constantly|juxt|comp|fnil|some|every\\?|not-any\\?|not-every\\?|identity|apply)\\b|->>|->"
    },
    "special": {
      "name": "keyword.operator.bars",
      "match": "['`~@^]"
    },
    "number": {
      "name": "constant.numeric.bars",
      "match": "-?\\b\\d+(\\.\\d+)?\\b"
    },
    "bool-nil": {
      "name": "constant.language.bars",
      "match": "\\b(true|false|nil)\\b"
    },
    "keyword-lit": {
      "name": "constant.other.keyword.bars",
      "match": ":[A-Za-z0-9_\\-\\+\\*/!?]+"
    },
    "symbol": {
      "name": "variable.other.bars",
      "match": "[A-Za-z_\\-\\+\\*/%<>=!?][A-Za-z0-9_\\-\\+\\*/%<>=!?]*"
    }
  }
}
